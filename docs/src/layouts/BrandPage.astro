---
import '../theme/base.css';
import ThemeInit from '../theme/components/ThemeInit.astro';
import ThemeToggle from '../theme/components/ThemeToggle.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShopIcon from '../components/ShopIcon.astro';
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
<title>{title} | 4mple Lab</title><meta name="description" content={description} />
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
<link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
<meta property="og:title" content={`${title} | 4mple Lab`} /><meta property="og:description" content={description} />
<meta property="og:type" content="website" /><meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
<meta property="og:site_name" content="4mple Lab" />
<meta property="og:locale" content="ja_JP" />
<meta property="og:image" content={new URL('/img/ogp-brand.png', Astro.site)} />
<meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="4mple Lab — Less is More." />
<meta name="twitter:card" content="summary_large_image" />
<ThemeInit />
</head>
<body>
<a class="skip" href="#main">本文へ移動</a>
<header><a class="brand" href="/">4mple Lab</a><nav aria-label="メイン"><a href="/LisM/">LisM</a><a class="shop-button" href="https://shop.4mple-lab.com/" target="_blank" rel="noopener noreferrer"><ShopIcon />ショップ <span aria-hidden="true">↗</span></a><ThemeToggle /></nav></header>
<main id="main" data-pagefind-body><slot /></main>
<SiteFooter />
</body>
</html>
<style is:global>
* { box-sizing:border-box; }
body { margin:0; font-family:var(--site-font); background:var(--bg); color:var(--text); }
a { color:inherit; text-decoration:none; } a:hover { color:var(--muted); }
a:focus-visible { outline:2px solid var(--accent); outline-offset:5px; }
main { width:min(1120px,calc(100% - 64px)); margin:auto; }
header { width:100%; padding-inline:24px; background:var(--canvas); min-height:64px; display:flex; align-items:center; justify-content:space-between; gap:20px; border-bottom:1px solid var(--frame-border); }
.shop-button { display:inline-flex; align-items:center; gap:8px; border:1px solid var(--border); background:var(--surface); border-radius:6px; padding:9px 12px; color:var(--text); white-space:nowrap; }
.shop-button:hover { background:var(--soft); color:var(--text); }
.shop-button svg { width:18px; height:18px; }
.brand { font-size:24px; font-weight:700; } nav { display:flex; align-items:center; gap:24px; font-size:14px; }
.hero { padding:100px 0 72px; } .eyebrow { font-size:12px; letter-spacing:.16em; color:var(--muted); }
h1 { font-size:clamp(40px,6vw,76px); line-height:1.35; margin:24px 0; letter-spacing:-.025em; }
p { line-height:1.9; color:var(--muted); } .lead { font-size:18px; }
.card { display:grid; grid-template-columns:1fr 1.3fr; gap:40px; padding:40px; background:var(--soft); border:1px solid var(--border); border-radius:12px; align-items:center; margin-bottom:64px; }
.top-product-photo { aspect-ratio:16 / 9; object-fit:cover; }
.card img { width:100%; height:auto; display:block; border-radius:8px; }
h2 { font-size:32px; } .links { display:flex; flex-wrap:wrap; gap:24px; margin-top:24px; }.links a { text-decoration:underline; text-underline-offset:6px; }
.skip { position:absolute; top:-100px; }.skip:focus { top:8px; background:var(--bg); padding:12px; }
@media(max-width:700px){main{width:calc(100% - 40px)}header{padding-inline:16px}nav{gap:12px;font-size:12px}.brand{font-size:20px}.hero{padding:64px 0 40px}.card{grid-template-columns:1fr;padding:24px;gap:16px}.lead{font-size:16px}}
</style>
