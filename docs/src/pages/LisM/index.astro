---
import { Image } from 'astro:assets';
import '../../styles/home.css';
import ThemeInit from '../../theme/components/ThemeInit.astro';
import ProductHeader from '../../components/ProductHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import hero from '../../assets/product/20261002_180000_hero-white.png';
import allModules from '../../assets/product/20261002_184500_modules-centered.png';
import black from '../../assets/product/20261002_180000_color-keycaps-white.png';
import caseColors from '../../assets/product/20261002_180000_case-colors-white.png';
import blackCopper from '../../assets/product/black-copper.jpg';
import redBlack from '../../assets/product/20261002_180000_red-black-white.png';
import specDiagram from '../../assets/product/20261002_180000_spec-light-white.png';
import specDiagramDark from '../../assets/product/20261002_171000_lism-spec-dark-wide.png';
const base = '/LisM';
const shop = 'https://shop.4mple-lab.com/items/119269662';
const description = '親指の1Uを自分らしく。LisMは左右それぞれの親指位置のモジュールを交換できる、コンパクトな分割キーボードです。';
const modules = [
 ['トラックボール', '10・12・14・19mmから選べるボール径。PAW3222センサーとベアリングを採用。'],
 ['ロータリーエンコーダー', 'クリック付きの水平タイプと、5pin対応の垂直タイプ。'],
 ['キースイッチ', '親指にも、いつものキーを。ホットスワップには非対応です。'],
 ['4wayスティック', '親指の位置に、4方向の操作を。'],
];
---
<!doctype html>
<html lang="ja">
<head>
 <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
 <ThemeInit />
 <title>LisM — 親指の1Uを自分らしく。</title>
 <meta name="description" content={description} />
 <link rel="canonical" href={new URL(`${base}/`, Astro.site)} />
 <link rel="icon" href={`${base}/favicon.svg?v=2`} type="image/svg+xml" />
 <meta property="og:title" content="LisM — 親指の1Uを自分らしく。" />
 <meta property="og:description" content={description} />
 <meta property="og:type" content="website" />
 <meta property="og:url" content={new URL(`${base}/`, Astro.site)} />
 <meta property="og:image" content="https://4mplelab.github.io/LisM/img/ogp_lism.png" />
 <meta property="og:site_name" content="4mple Lab" />
 <meta property="og:locale" content="ja_JP" />
 <meta property="og:image:alt" content="モジュール式分割キーボード LisM" />
 <meta name="twitter:card" content="summary_large_image" />
 <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-C13DXFJ6RG"></script>
 <script is:inline>window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', 'G-C13DXFJ6RG');</script>
</head>
<body>
 <a class="skip" href="#main">本文へ移動</a>
 <header><ProductHeader /></header>
 <main id="main" data-pagefind-body>
  <section class="hero wrap">
   <p><a class="text-link" href="/">4mple Lab / LisM</a></p>
   <p class="eyebrow">MODULAR SPLIT KEYBOARD</p>
   <h1>親指の1Uを<br />自分らしく</h1>
   <p class="intro">トラックボールも、ダイヤルも、キーも。<br />左右の親指から、使い心地を変えられる。<br class="mobile-break" />分割キーボード、LisM（リズム）。</p>
   <a class="text-link" href="#features">LisMを知る <span aria-hidden="true">↓</span></a>
   <Image class="hero-photo" src={hero} alt="左右に分かれた白いLisMと、交換用の親指モジュール" loading="eager" fetchpriority="high" />
   <div class="hero-facts"><div><strong>17<span>mm</span></strong><p>キーの間隔</p></div><div><strong>40<span>keys</span></strong><p>モジュール次第で最大42キー</p></div><div><strong>1<span>U</span></strong><p>左右それぞれ、交換できる親指部</p></div></div>
  </section>
  <section id="features" class="section soft">
   <div class="wrap"><p class="eyebrow">MAKE IT YOURS</p><h2>使ってからも<br />自分に合わせて</h2>
    <div id="concept" class="concept-copy">
     <p>入力デバイスの好みは、使ってみて初めて分かるもの。LisMは親指のモジュールを交換できるので、購入後も好みや作業内容に合わせて、自分に合う組み合わせを探せます。</p>
     <details class="concept-details">
      <summary>開発コンセプトをもっと読む</summary>
      <p>トラックボールやロータリーエンコーダーの使用感は、慣れによっても変わります。「想像していた使用感と違った」「別のデバイスを試したい」。そんなときも、キーボード全体を買い替えずに構成を見直せるようにしました。</p>
      <p>たとえば「ボールを反対側にしたい」「よりシンプルなキーにしたい」といった希望に合わせて、左右それぞれの親指部を交換できます。</p>
      <p>モジュールの交換には数分かかるため、頻繁に切り替えるよりも、じっくり使い比べることを想定しています。</p>
     </details>
    </div>
    <Image class="wide-photo" style="aspect-ratio:16/9;object-fit:cover" src={allModules} alt="LisM本体と交換用モジュールの一覧。19mmトラックボールを含む構成" widths={[640, 1024, 1600]} sizes="(max-width: 760px) 100vw, 1120px" />
    <div class="module-grid">{modules.map(([title, text], i) => <article><span class="number">0{i + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
    <p class="note">写真には旧仕様のケースを含みます。2026年10月1日販売分から、本体とモジュールの固定ははめ込み式に変更しています。</p>
    <a class="text-link" href={`${base}/how2/`}>モジュールの交換方法 <span aria-hidden="true">→</span></a>
   </div>
  </section>
  <section class="section wrap split">
   <div><p class="eyebrow">SMALL, BY DESIGN</p><h2>小さく<br />整然と</h2><p class="lead">17mmピッチの格子配列。<br />必要なキーを、コンパクトに。</p><p>マイコンを表面実装し、基板の余白を詰めた設計。40キーを基本に、親指モジュールの構成により最大42キーまで使えます。</p></div>
   <Image src={black} alt="黒いLisMに白と紫のキーキャップを組み合わせた構成" widths={[640, 1024, 1600]} sizes="(max-width: 760px) 100vw, 60vw" />
  </section>
  <section class="section soft"><div class="wrap">
   <p class="eyebrow">ROOM TO CUSTOMIZE</p><h2>中身も見た目も<br />あなたの道具に</h2>
   <Image class="wide-photo" src={caseColors} alt="白・ライトグレー・グレー・黒のLisMケースを重ねたカラーバリエーション" widths={[640, 1024, 1600]} sizes="(max-width: 760px) 100vw, 1120px" />
   <div class="three-grid"><article><h3>キーの役割を変える</h3><p>ZMKファームウェアに対応。キーマップを、自分の操作に合わせてカスタマイズできます。</p><a href={`${base}/firmware/`}>ファームウェアについて →</a></article><article><h3>手入れをしやすく</h3><p>本体ケースはネジレス構造。内部にアクセスしやすく、メンテナンスにも配慮しています。一部モジュールにはネジを使用します。</p><a href={`${base}/build_guides/`}>組み立て方を見る →</a></article><article><h3>好きな色でつくる</h3><p>ケースの3Dデータを公開。自分で印刷して、用意されたカラー以外の組み合わせも楽しめます。</p><a href="https://github.com/4mplelab/LisM/tree/main/3d-data" target="_blank" rel="noopener noreferrer">3Dデータを見る ↗</a></article></div>
   <div class="product-gallery">
    <figure><Image src={redBlack} alt="赤と黒のトラックボールを組み合わせた白いLisM" widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 560px" /><figcaption>白いケースに、赤と黒のトラックボールを。</figcaption></figure>
    <figure><Image src={blackCopper} alt="黒いキーキャップと銅の縁取りを組み合わせたLisM" widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 560px" /><figcaption>黒と銅を組み合わせた外観。</figcaption></figure>
   </div>
   <p class="note">写真は色や構成の一例です。旧仕様のケースを含みます。</p>
  </div></section>
  <section id="specs" class="section wrap specs"><div><p class="eyebrow">SPECIFICATIONS</p><h2>小さなボディの<br />基本仕様</h2></div><dl><div><dt>キー数</dt><dd>40キー（最大42キー）</dd></div><div><dt>配列</dt><dd>オーソリニア／17mmピッチ</dd></div><div><dt>対応スイッチ</dt><dd>Kailh Choc V1 / V2</dd></div><div><dt>サイズ</dt><dd>W 109 × D 75 × H 17.5 mm<small>高さはキートップまで</small></dd></div><div><dt>重量</dt><dd>左右合計 約200g<small>14mmボール・垂直エンコーダー構成時</small></dd></div><div><dt>ファームウェア</dt><dd>ZMK<small>将来的なRMK対応も検討中</small></dd></div></dl><div class="spec-diagram"><Image class="spec-image-light" src={specDiagram} alt="LisMのサイズと仕様を示す図" widths={[640, 1024, 1600]} sizes="(max-width: 760px) 100vw, 1120px" /><Image class="spec-image-dark" src={specDiagramDark} alt="黒いLisMの構成例と寸法・重量を示す仕様図" widths={[640, 1024, 1600]} sizes="(max-width: 760px) 100vw, 1120px" /></div></section>
  <section class="section soft"><div class="wrap"><p class="eyebrow">SEE IT IN ACTION</p><h2>使うところを<br />見てみよう</h2><p class="lead">にょろ様に制作・ナレーションいただいた、LisMの使用感を紹介する動画です。</p>
   <div class="video"><iframe loading="lazy" src="https://www.youtube.com/embed/7TakXXCns3c" title="LisM 使用感 — にょろ様" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
   <details><summary>紹介・レビュー動画も見る</summary><p>VTuberのにょろ様による紹介動画と、実際にLisMを使用したレビューです。</p><div class="video-grid">{[['qeBLQwE-HCc','LisM 紹介動画'],['NgNVPIE7CQk','LisM レビュー動画'],['ha2UtzMb4vI','LisM レビュー動画 2']].map(([id,title]) => <div class="video"><iframe loading="lazy" src={`https://www.youtube.com/embed/${id}`} title={title} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>)}</div></details>
  </div></section>
  <section class="section wrap resources"><p class="eyebrow">GET STARTED</p><h2>自分のLisMを<br />ここから</h2><div class="actions"><a class="button" href={shop} target="_blank" rel="noopener noreferrer">販売ページへ ↗</a><a class="button secondary" href={`${base}/build_guides/`}>ビルドガイドへ →</a></div><div class="resource-links"><a href={`${base}/how2/`}>使い方・HowTo</a><a href={`${base}/firmware/`}>ファームウェア設定</a><a href="https://github.com/4mplelab/zmk-config-LisM" target="_blank" rel="noopener noreferrer">ファームウェアのソース ↗</a></div>
   <details class="keymap"><summary>デフォルトキーマップ</summary><p>Mac向けに独自のキー配置を設定しています。そのまま使うことを前提とせず、使用する環境や好みに合わせてキーマップを変更してください。</p><img src="https://raw.githubusercontent.com/4mplelab/zmk-config-LisM/refs/heads/main/keymap-drawer/lism.svg" alt="LisMのデフォルトキーマップ" loading="lazy" /></details>
  </section>
 </main>
 <SiteFooter />
</body>
</html>
